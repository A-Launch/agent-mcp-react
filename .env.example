# Key names and shared-dev values only. Keep per-developer secrets blank.

# --- example application ---
# WebSocket endpoint the page dials. The browser is the MCP server and connects outbound.
AMR_AGENT_WS_URL=ws://localhost:45000
# Where the page fetches a single-use connection ticket. Stands in for an application backend.
AMR_TICKET_URL=http://localhost:45000/ticket
# 0 turns OFF the in-page inspector and window.__AGENT_MCP__. On by default in this example, because
# inspecting it is the point. The channel also needs a development build — both, never either.
AMR_INSPECTOR=
# none | standard | inspect | developer. Wired: an unrecognised value REFUSES to start rather than
# defaulting.
#   none       grants nothing. Every agent call is refused at the capability step, while the page's
#              own scripts keep calling the same tools — which is the pairing that shows a capability
#              governs this library's bridge and not the page.
#   standard   Level 1 only: the application's own tools. The default and the recommended shape.
#   inspect    Level 1 plus READING the page — dom.snapshot and dom.get_text. The agent
#              can describe this page and cannot touch it, which is what makes the two halves of the
#              dom capability visibly different. dom.interact stays withheld.
#   developer  Level 1 plus BOTH halves of the DOM capability — reading the page and acting on it.
#   evaluate   everything, including runtime.evaluate. Equivalent to arbitrary code execution in
#              this page's origin — the DOM, application globals, storage, same-origin requests, and
#              any non-HttpOnly credential the page can reach. A person must approve every call.
#              A SEPARATE profile rather than part of `developer`, because bundling arbitrary code
#              execution into "the developer preset" is how it ends up somewhere nobody meant it to be.
#              Never the default of anything, and never enabled to unblock a task.
# `read-only` is deliberately absent: a capability is per-LEVEL, so no combination of these can mean
# "may read but not write". That distinction is per-tool and belongs to the application.
AMR_CAPABILITIES=standard

# --- mock agent runtime ---
AMR_GATEWAY_PORT=45000
# The chat agent's model credential. Key name only — never commit a value.
# Without it the stack still runs: the chat says so and the tool console calls tools directly.
ANTHROPIC_API_KEY=
# Which model the chat agent reasons with.
AMR_MODEL=claude-sonnet-5
